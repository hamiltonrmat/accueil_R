<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- URL de démarrage de votre examen -->
    <key>startURL</key>
    <string>https://ferdaousbg.github.io/plateforme-R/</string>

    <!-- Mot de passe pour quitter SEB (à remplacer par un VRAI mot de passe) -->
    <key>hashedQuitPassword</key>
    <string>f33a74ec9368507a1f96b76129a4b635d45d9091f9cf11fe76ea26c08bfea217</string>

    <!-- Mode kiosque : plein écran sans navigation -->
    <key>browserViewMode</key>
    <integer>1</integer>
    <key>mainBrowserWindowWidth</key>
    <string>100%</string>
    <key>mainBrowserWindowHeight</key>
    <string>100%</string>

    <!-- Désactiver l'affichage des préférences côté étudiant -->
    <key>allowPreferencesWindow</key>
    <false/>

    <!-- Bloquer captures et enregistrement d'écran (macOS) -->
    <key>allowScreenCapture</key>
    <false/>
    <key>allowWindowCapture</key>
    <false/>
    <key>blockScreenShotsLegacy</key>
    <true/>

    <!-- Bloquer le partage d'écran -->
    <key>allowScreenSharing</key>
    <false/>

    <!-- Désactiver clic droit, copier/coller, recherche -->
    <key>enableRightMouse</key>
    <false/>
    <key>browserWindowAllowAddressBar</key>
    <false/>
    <key>browserWindowAllowReload</key>
    <false/>

    <!-- Filtre URL : seul votre domaine est autorisé -->
    <key>URLFilterEnable</key>
    <true/>
    <key>URLFilterEnableContentFilter</key>
    <true/>
    <key>URLFilterRules</key>
    <array>
        <dict>
            <key>active</key>
            <true/>
            <key>action</key>
            <integer>1</integer>
            <key>expression</key>
            <string>*votre-app.railway.app*</string>
            <key>regex</key>
            <false/>
        </dict>
    </array>

    <!-- Empêcher de quitter SEB sans mot de passe -->
    <key>allowQuit</key>
    <true/>

    <!-- Mode utilisation : 0 = démarrer un examen -->
    <key>sebConfigPurpose</key>
    <integer>0</integer>

    <!-- Navigateur en plein écran -->
    <key>touchOptimized</key>
    <false/>
</dict>
</plist>
